# Copiar a .env y completar. .env NO se sube al repositorio.
# Generar claves largas, por ejemplo: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
AUTHENTICATOR_PASSWORD=
JWT_SECRET=

# Horas que dura una sesión antes de pedir login de nuevo.
SESSION_HOURS=8
# Tamaño máximo de un CSV subido.
MAX_UPLOAD_MB=50
# Tiempo máximo de una consulta.
STATEMENT_TIMEOUT=120s
DB_POOL=10

# Puerto del servidor donde se publica el sistema.
PUERTO=8000
